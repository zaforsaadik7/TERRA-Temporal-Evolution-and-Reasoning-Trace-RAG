# ============================================================
# TERRA — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual API keys.
# The .env file is never committed to Git (it is in .gitignore).
# Do NOT share your .env file or paste these keys anywhere public.
#
# HOW TO GET EACH KEY:
#   GEMINI_API_KEY        → https://aistudio.google.com/ → Get API Key → Create API Key
#   GOOGLE_JUDGE_API_KEY  → Same page as above, but create a SECOND key.
#                           Using a different key prevents self-evaluation bias
#                           (the judge and generator use separate quota buckets).
#
# OPTIONAL KEYS (server starts without these):
#   AWS_BEARER_TOKEN_BEDROCK → Only needed if using the Bedrock inference backend.
#                              Leave blank or omit — a warning will print but nothing breaks.
# ============================================================

# Required: Primary inference key (used for Traffic Cop routing, Smart Grader, and generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Separate judge key (used only for evaluation — keeps judge independent from generator)
GOOGLE_JUDGE_API_KEY=your_google_judge_api_key_here

# Optional: AWS Bedrock Mantle bearer token (disabled if not set)
AWS_BEARER_TOKEN_BEDROCK=
