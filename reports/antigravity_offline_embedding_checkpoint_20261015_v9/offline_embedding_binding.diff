+            "firewall_rule_id": self.firewall_rule_id,
+            "issued_utc": self.issued_utc,
+        }
+        canonical_bytes = json.dumps(fields_dict, sort_keys=True).encode("utf-8")
+        return hashlib.sha256(canonical_bytes).hexdigest().lower()
