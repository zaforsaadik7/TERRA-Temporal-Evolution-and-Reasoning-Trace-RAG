"""Pure command rendering using fake files; never launches a process."""
from dataclasses import replace
from pathlib import Path
import unittest
from unittest.mock import patch
from scripts.matched_baseline import offline_cohort_command as command
from tests import test_offline_cohort_launch_synthetic as fixtures


class CommandTests(unittest.TestCase):
    def setUp(self):
        self.f=fixtures.LaunchTests();self.f.setUp()
        self.addCleanup(self.f.doCleanups)
        system=str(Path(dict(self.f.launch.artifacts)['powershell'].path).parent)
        self.command=command.ControllerCommand(self.f.launch,system,'C:\\Users\\Fixture')

    def test_exact_argv_and_clean_environment(self):
        with patch('subprocess.Popen',side_effect=AssertionError('no process')), \
             patch.object(Path,'open',side_effect=AssertionError('pure data only')):
            data=self.command.payload()
        self.assertEqual(data['argv'][1:3],['-I','-B'])
        self.assertEqual(data['argv'][4:],[
            '--launch-context',str(self.f.launch.attempt_root/'launch_context.json'),
            '--approval',str(self.f.launch.attempt_root/'approval.json')])
        self.assertEqual(set(data['environment']),{'PATH','SYSTEMROOT','WINDIR','USERPROFILE'})
        self.assertFalse(data['inherit_environment']);self.assertFalse(data['shell'])
        self.assertEqual(data['status'],'PROSPECTIVE_NOT_EXECUTABLE')

    def test_environment_and_policy_changes_change_new_digest(self):
        baseline=self.command.digest()
        self.assertNotEqual(baseline,replace(self.command,user_profile='C:\\Users\\Other').digest())
        self.assertNotEqual(baseline,replace(self.command,
            launch=replace(self.f.launch,poll_seconds=.5)).digest())
        self.assertNotEqual(baseline,self.f.launch.digest())

    def test_ambient_secrets_not_inherited(self):
        with patch.dict('os.environ',{'HF_TOKEN':'SYNTHETIC_SECRET','PYTHONPATH':'bad'}):
            self.assertNotIn('SYNTHETIC_SECRET',str(self.command.payload()))
            self.assertNotIn('PYTHONPATH',self.command.payload()['environment'])

    def test_wrong_system_and_invalid_profile_rejected(self):
        for item in (replace(self.command,system_directory='C:\\Wrong'),
                     replace(self.command,user_profile='relative'),
                     replace(self.command,user_profile='C:\\Users\\bad\nvalue')):
            with self.assertRaises(ValueError):item.payload()

    def test_windows_quoting_and_gate(self):
        role_pins=dict(self.f.launch.artifacts)
        original=role_pins['controller_entry']
        changed=replace(original,path=str(Path(original.path).parent/'entry with spaces.py'))
        role_pins['controller_entry']=changed
        review=replace(self.f.launch.parent,pins=tuple(
            changed if p==original else p for p in self.f.launch.parent.pins))
        launch=replace(self.f.launch,parent=review,artifacts=tuple(sorted(role_pins.items())))
        data=replace(self.command,launch=launch).payload()
        self.assertIn('"'+changed.path+'"',data['windows_command_line'])
        self.assertFalse(command.COHORT_COMMAND_ADMITTED)
        self.assertEqual(command.main(),2)


if __name__=='__main__':unittest.main()
