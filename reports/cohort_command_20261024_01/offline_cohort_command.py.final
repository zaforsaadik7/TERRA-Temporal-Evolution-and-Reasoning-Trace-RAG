"""Pure prospective controller command. No subprocess or authentic admission.

This adds a new digest above the older policy digest; it does not silently
upgrade old approvals. CLI parsing, native dispatch and process identity checks
remain separate, unfinished work.
"""
from dataclasses import dataclass
from hashlib import sha256
from pathlib import Path
import subprocess
from scripts.matched_baseline.offline_cohort_contracts import encode
from scripts.matched_baseline.offline_cohort_launch import CohortLaunchBinding
from scripts.matched_baseline.offline_smoke_bindings import windows_runtime_environment

COHORT_COMMAND_ADMITTED = False


@dataclass(frozen=True)
class ControllerCommand:
    launch: CohortLaunchBinding
    system_directory: str
    user_profile: str

    def payload(self):
        if type(self.launch) is not CohortLaunchBinding:
            raise ValueError('Typed reviewed launch required')
        self.launch.validate()
        # Native path semantics, not a shell string. Validation is lexical only.
        env=windows_runtime_environment(system_directory=self.system_directory,
                                        user_profile=self.user_profile)
        roles=dict(self.launch.artifacts)
        if Path(roles['powershell'].path).parent != Path(self.system_directory):
            raise ValueError('System directory differs from pinned PowerShell directory')
        paths=self.launch.payload()['paths']
        argv=[roles['controller_image'].path,'-I','-B',
              roles['controller_entry'].path,'--launch-context',paths['context'],
              '--approval',paths['approval']]
        for value in argv+list(env.values()):
            if type(value) is not str or any(c in value for c in '\0\r\n'):
                raise ValueError('Invalid command/environment value')
        return dict(schema='TERRA_COHORT_CONTROLLER_COMMAND_V1',
            policy_sha256=self.launch.digest(),executable=argv[0],argv=argv,
            windows_command_line=subprocess.list2cmdline(argv),
            cwd=self.launch.parent.plan.workspace,environment=env,
            inherit_environment=False,shell=False,
            status='PROSPECTIVE_NOT_EXECUTABLE',
            process_identity='UNVERIFIED_LAUNCHER_TO_BASE_IMAGE_MAPPING',
            child_command='PENDING_RECEIPT_AND_NATIVE_CHILD_REVIEW')

    def digest(self):
        return sha256(encode(self.payload(),8*1024**2)).hexdigest()


def main():
    print('BLOCKED: controller CLI, native dispatch and fresh authority pending')
    return 2


if __name__=='__main__':raise SystemExit(main())
