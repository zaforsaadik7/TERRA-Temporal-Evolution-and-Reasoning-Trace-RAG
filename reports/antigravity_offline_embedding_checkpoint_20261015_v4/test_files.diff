+                self.killed = False
+            def poll(self):
+                return None
+            def kill(self):
+                self.killed = True
+
+        proc = HangingProc()
+        time_states = [100.0, 170.0, 170.0]
+        def advancing_clock():
+            if time_states:
+                return time_states.pop(0)
+            return 170.0
+
+        sup = OfflinePreflightSupervisor(
+            source_dir=src_dir,
+            expected_sqlite_sha256=exp_sha,
+            timeout_seconds=60.0,
+            process_runner=lambda cmd, env: proc,
