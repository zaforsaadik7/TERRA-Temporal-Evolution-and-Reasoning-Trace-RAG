+                missing.append({
+                    "relative_path": rel,
+                    "pre_sha256": pre_ent["sha256"],
+                    "role": pre_ent["role"],
+                })
+            else:
+                post_ent = post_items[rel]
+                if pre_ent["sha256"] != post_ent["sha256"]:
+                    changed.append({
+                        "relative_path": rel,
+                        "pre_sha256": pre_ent["sha256"],
+                        "post_sha256": post_ent["sha256"],
+                        "role": pre_ent["role"],
+                    })
+
+        for rel, post_ent in post_items.items():
+            if rel not in pre_items:
+                added.append({
