+"""Five-role fictional structured-output diagnostic. Not a study/resume path."""
+import sys,time
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[2]
+PROBE_ADMITTED=False
+ROLES=('router','verifier','generator','judge1','judge2')
+QUERY='What year is stated in the supplied fictional note?'
+EVIDENCE='[Document 1] ID: fictional-note | Title: Fictional Note (1900)\nSnippet: This invented note states the year 1900. It is not a real case or legal authority.'
+
+def execute(*,out,configs,tokenizers,factory,bearer,deadline,now=time.monotonic):
+    from scripts.matched_baseline.provider_accounting import BudgetJournal,CallIdentity,ContractError
+    from scripts.matched_baseline.provider_run_control import EndpointQuota
+    from scripts.matched_baseline.paired_study_runtime import StudyStore,MeasuredCallSession
+    from scripts.matched_baseline.paired_dependency_bridge import measure_request
+    from scripts.matched_baseline.paired_prompt_workflow import parsed_content
+    from scripts.matched_baseline.paired_preparation_native import write_new
+    store=StudyStore(out,('FORMAT_COMPAT_001',),16*1024**2)
+    journal=BudgetJournal(Path(out)/'calls.jsonl',10**9,5)
+    quotas={r:EndpointQuota(1000000,1000000,1000) for r in ROLES}
+    session=MeasuredCallSession(journal,store,configs,quotas,factory,bearer,now,lambda:now()>=deadline)
+    completed=[];answer=None;failure=None
+    try:
+        for role in ROLES:
+            if now()>=deadline:raise TimeoutError('Probe overall deadline')
+            req=measure_request(CallIdentity('FORMAT_COMPAT_001','shared' if role=='router' else 'H',role),
+                configs[role],tokenizers[role],QUERY,EVIDENCE,answer if role.startswith('judge') else None)
+            # Same stage byte/count trace as the study, not a guess from chars.
+            store.record(dict(kind='MEASURED_REQUEST',call=req.identity.key,local_tokens=req.local_tokens,
+                rendered_sha256=req.rendered_sha256,request_sha256=__import__('hashlib').sha256(req.request).hexdigest(),
+                prompt_contract_sha256=req.prompt_contract_sha256))
+            result=session(req);parsed=parsed_content(role,result.content)
+            if role=='generator':answer=parsed
+            completed.append(dict(role=role,local_prompt_tokens=req.local_tokens,
+                provider_prompt_tokens=result.prompt_tokens,provider_completion_tokens=result.completion_tokens,
+                provider_minus_local=result.prompt_tokens-req.local_tokens,returned_model=result.returned_model))
+    except BaseException as e:
+        failure=type(e).__name__
+        store.record(dict(kind='PROBE_FAILURE',failure_type=failure))
+    finally:
+        journal.close();store.close()
+    terminal=dict(status='FIVE_ROLE_COMPATIBILITY_PASS' if failure is None else 'STOPPED_NO_RETRY',
+        completed_roles=completed,failure_type=failure,calls_reserved=len(journal.entries),
+        reference_exposure_nanodollars=journal.exposure,study_authorized=False,
+        delta_interpretation='Provider minus local count; not isolated schema overhead or worst-case fit certification')
+    write_new(Path(out)/'terminal.json',terminal)
+    return terminal
+
+def main(argv=None):
+    if not PROBE_ADMITTED:print('BLOCKED: separate probe admission absent');return 2
+    if str(ROOT) not in sys.path:sys.path.insert(0,str(ROOT))
+    import argparse,json
+    from scripts.matched_baseline.paired_format_probe_anchor import PLAN_PATH,PLAN_SHA256
+    from scripts.matched_baseline.paired_preparation_native import read_pinned,sha,encode,pin_file
+    p=argparse.ArgumentParser();p.add_argument('--plan',required=True);p.add_argument('--sha',required=True)
+    p.add_argument('--role',choices=('worker',),required=True);a=p.parse_args(argv)
+    if PLAN_PATH is None or (a.plan,a.sha)!=(PLAN_PATH,PLAN_SHA256):raise ValueError('Probe external identity differs')
+    raw=Path(a.plan).read_bytes()
+    if sha(raw)!=a.sha or len(raw)>16*1024**2:raise ValueError('Probe plan differs')
+    plan=json.loads(raw)
+    if (plan['scope']!='FIVE_ROLE_STRUCTURED_COMPATIBILITY' or plan['maximum_calls']!=5
+        or plan['cap_nanodollars']!=10**9 or not plan['human_message'].strip()):raise ValueError('Probe scope differs')
+    for pin in plan['selected_worker_inputs']:
+        if pin_file(pin['path'])!=pin:raise ValueError('Worker code/tokenizer input drift')
+    from scripts.matched_baseline.offline_preflight import CanonicalRoleConfigFactory,InProcessNetworkBlocker
+    from scripts.matched_baseline.paired_study_candidate import candidate
+    from scripts.matched_baseline.provider_accounting import RoleConfig,Price
+    from scripts.matched_baseline import provider_run_control as provider
+    from scripts.matched_baseline.inspect_databricks_metadata import load_token
+    from scripts.matched_baseline.paired_preparation_native import write_new
+    started=time.monotonic();deadline=started+plan['resources']['child_seconds']-30
+    with InProcessNetworkBlocker():
+        roles=CanonicalRoleConfigFactory.build_role_configs(ROOT/'assets/tokenizers',workspace_root=ROOT)
+        tokenizers={r:v.tokenizer for r,v in roles.items()}
+    configs={}
+    for row in candidate()['roles']:
+        row=dict(row);row['price']=Price(**row['price']);row['accepted_models']=tuple(row['accepted_models'])
+        c=RoleConfig(**row);configs[c.role]=c
+    secret=[]
+    def bearer():
+        if not secret:secret.append(load_token(ROOT/'.env.terra-databricks.local'))
+        return secret[0]
+    def factory(c):
+        connection=provider.create_live_connection(c)
+        original=connection.getresponse
+        def observed_response():
+            response=original()
+            if response.status!=200:
+                body=response.read(16384).decode('utf-8',errors='replace')
+                if secret:body=body.replace(secret[0],'[REDACTED]')
+                write_new(Path(plan['attempt_dir'])/'http_failure.json',dict(role=c.role,status=response.status,
+                    body_prefix=body,body_truncation_possible=True))
+            return response
+        connection.getresponse=observed_response
+        return connection
+    if provider.TLS_FACTORY_ADMITTED is not False:raise ValueError('Unexpected TLS admission')
+    try:
+        provider.TLS_FACTORY_ADMITTED=True
+        result=execute(out=Path(plan['attempt_dir'])/'results',configs=configs,tokenizers=tokenizers,
+            factory=factory,bearer=bearer,deadline=deadline)
+    finally:provider.TLS_FACTORY_ADMITTED=False;secret.clear()
+    print('STRUCTURED PROBE OUTCOME:',result['status'],flush=True)
+    return 0 if result['status']=='FIVE_ROLE_COMPATIBILITY_PASS' else 1
+
+if __name__=='__main__':
+    try:raise SystemExit(main())
+    except Exception as e:print('PROBE FAILURE TYPE:',type(e).__name__,flush=True);raise SystemExit(1)
