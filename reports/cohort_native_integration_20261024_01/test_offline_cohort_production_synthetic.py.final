"""Production shape with fake native APIs/readers and temporary output only.

The AUTHENTIC schema used in this test is a fabricated schema fixture, never an
observation of genuine execution. No canonical benchmark/store/model is opened.
"""
import base64
from contextlib import ExitStack
from dataclasses import asdict,replace
from hashlib import sha256
import inspect
import json
import os
from pathlib import Path
from types import SimpleNamespace
import unittest
from unittest.mock import Mock,patch
from scripts.matched_baseline import offline_cohort_production as production
from scripts.matched_baseline.offline_cohort_packet import packet_body,run_digest
from scripts.matched_baseline.offline_cohort_input import FilePin,FileReadReceipt
from scripts.matched_baseline.offline_cohort_execution import BenchmarkBinding
from scripts.matched_baseline.offline_cohort_contracts import CohortReportBuilder,encode
from scripts.matched_baseline.offline_smoke_windows_job import WindowsJobBackend
from scripts.matched_baseline.offline_smoke_windows_backend import WindowsBoundaryBackend
from scripts.matched_baseline.offline_preflight import IsolationReceipt,IntegrityLifecycleManager
from tests import test_offline_cohort_packet_synthetic as packet_fixtures
from tests import test_offline_cohort_core_synthetic as row_fixtures
from tests import test_offline_smoke_windows_job_synthetic as kernel_fixtures


class ProductionShapeTests(unittest.TestCase):
    def setUp(self):
        self.f=packet_fixtures.PacketTests();self.f.setUp();self.addCleanup(self.f.doCleanups)
        command=self.f.command;review=command.launch.parent;spec=review.spec
        old=next(pin for pin in review.pins if pin.path==review.benchmark_path)
        benchmark=FilePin(spec.benchmark_path,old.size_bytes,spec.benchmark_sha256)
        review=replace(review,benchmark_path=spec.benchmark_path,synthetic_fixture=False,
            pins=tuple(benchmark if pin==old else pin for pin in review.pins))
        self.command=replace(command,launch=replace(command.launch,parent=review))
        self.approval=dict(self.f.approval,launch_binding_sha256=run_digest(self.command))
        self.body=packet_body(self.command);self.roles=dict(self.command.launch.artifacts)
        self.command.launch.attempt_root.mkdir(parents=True)
        Path(self.command.launch.allocation.root).mkdir()
        self.integrity=Mock()
        isolation=IsolationReceipt('SYNTHETIC_RECEIPT',review.plan.source_directory,
            self.body['paths']['snapshot'],self.body['paths']['disposable'],'1'*64,1,'2026-10-24T00:00:00Z')
        self.integrity.prepare.return_value=isolation
        self.kernel=kernel_fixtures.FakeKernel();self.kernel.alive=False;self.kernel.active=0
        self.kernel.GetExitCodeProcess=lambda process,ptr:(setattr(ptr._obj,'value',0) or True)
        self.job=WindowsJobBackend(self.kernel,cwd=Path(review.plan.workspace))
        original_state=self.job.state
        self.job.state=lambda job,child:dict(original_state(job,child),output_bytes=0)
        self.rule=None
        def executor(argv):
            payload=json.loads(base64.b64decode(argv[-1]));operation=argv[-3]
            if operation=='environment':
                result=dict(administrator=True,service='Running',profiles=dict(Domain=True,Private=True,Public=True),
                    known_other_pids=[os.getpid()],verified_controller=dict(pid=os.getpid(),
                        program=payload['program'],start_ticks='123'),adapter_parent_pid=os.getpid())
            elif operation=='query':result=self.rule
            elif operation=='create':
                self.rule={k:payload[k] for k in ('name','program','owner_tag')}
                self.rule.update(direction='Outbound',action='Block',profile='Any',enabled=True);result=None
            elif operation=='remove':self.rule=None;result=None
            else:raise AssertionError('Unexpected fake boundary operation')
            return 0,json.dumps(result),''
        self.boundary_factory=lambda **kwargs:WindowsBoundaryBackend(
            powershell_path=kwargs['powershell_path'],script_path=kwargs['script_path'],
            receipt=kwargs['receipt'],executor=executor,controller_pid=kwargs['controller_pid'])
        self.benchmark_receipt=FileReadReceipt(benchmark,(1,1,benchmark.size_bytes,1,1),False)
        pairs=tuple((q.query_id,f'text {q.query_id[0]}{int(q.query_id[1:])}') for q in spec.queries)
        self.binding=BenchmarkBinding(spec.benchmark_path,spec.benchmark_sha256,benchmark.size_bytes,pairs,False)
        builder=CohortReportBuilder(spec,review.resources,expected_mode='AUTHENTIC_OFFLINE_FEASIBILITY')
        for identity in spec.queries:
            row=row_fixtures.fixture_row(identity);row['mode']='AUTHENTIC_OFFLINE_FEASIBILITY'
            row['execution_facts']=dict(retrieval='LOCAL_DISPOSABLE_STORE',embedding='LOCAL_PINNED_ONNX',
                tokenization='LOCAL_PINNED_TOKENIZERS',routes='HYPOTHETICAL_EASY_AND_HARD',
                judge_answer='SYNTHETIC_PLACEHOLDER',provider_certified=False,live_api_calls=0)
            builder.add(row)
        self.report=builder.finish()

    def invoke(self):
        from scripts.matched_baseline import offline_cohort_filesystem as fs
        from scripts.matched_baseline import offline_smoke_integrity as integrity
        from scripts.matched_baseline import offline_smoke_windows_assembly as windows
        from scripts.matched_baseline import offline_smoke_executor as executor
        from scripts.matched_baseline import offline_cohort_input as inputs
        def read(path,limit):
            if str(path)==self.command.launch.payload()['paths']['approval']:return encode(self.approval,65536)
            if Path(path).name=='cohort_report.json':return self.report
            raise AssertionError('Unexpected real-read request')
        with ExitStack() as stack:
            for target,name,value in (
                (production,'COHORT_PRODUCTION_ADMITTED',True),
                (production.sys,'executable',self.roles['controller_image'].path),
                (production,'_read',read),
                (fs,'_observe_review',Mock(return_value=(self.command.launch.parent.pins,self.command.launch.parent.roots))),
                (fs,'_storage',Mock(return_value=dict(evidence_bytes=0,disposable_bytes=10))),
                (integrity,'SmokeProtectedLifecycle',Mock(return_value=self.integrity)),
                (windows,'load_authentic_windows_library',Mock(return_value=self.kernel)),
                (windows,'DeferredCaptureJobBackend',Mock(return_value=self.job)),
                (executor,'construct_boundary_backend',self.boundary_factory),
                (inputs,'read_canonical_benchmark',Mock(return_value=(self.benchmark_receipt,self.binding)))):
                stack.enter_context(patch.object(target,name,value))
            return production.run_parent(self.command,self.approval,'2'*64)

    def test_full_parent_composition_over_fake_native_protocols(self):
        result=self.invoke()
        self.assertEqual(result['status'],'OFFLINE_FEASIBILITY_SUCCESS')
        self.assertTrue(result['report_verified']);self.assertIsNone(self.rule)
        self.integrity.final_check.assert_called_once()
        path=self.command.launch.allocation.directory('parent')/'terminal.json'
        self.assertEqual(json.loads(path.read_bytes())['status'],result['status'])
        self.assertEqual(self.kernel.events[:4],['job','suspended','assign','resume'])

    def test_failed_assignment_cannot_report_success_and_removes_only_owned_rule(self):
        self.kernel.failed_assignment=True
        result=self.invoke();self.assertEqual(result['status'],'FAIL')
        self.assertIsNone(self.rule);self.integrity.final_check.assert_called_once()
        self.assertIn('terminate_job',self.kernel.events)

    def test_final_protected_hash_failure_cannot_be_hidden_by_valid_report(self):
        self.integrity.final_check.side_effect=ValueError('synthetic drift')
        result=self.invoke();self.assertEqual(result['status'],'FAIL')
        self.assertTrue(result['report_verified']);self.assertFalse(result['postchecks_verified'])

    def test_actual_receipt_validator_signature_bound_without_opening_any_store(self):
        inspect.signature(IntegrityLifecycleManager.validate_disposable_containment).bind(
            receipt=self.integrity.prepare.return_value,candidate_dir=Path('C:/fixture/disposable'),
            expected_source_dir=Path('C:/fixture/source'),pre_binding=True)


if __name__=='__main__':unittest.main()
