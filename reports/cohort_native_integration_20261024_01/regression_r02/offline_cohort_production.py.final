"""Authentic cohort composition SOURCE. No packet or operation admitted.

External launcher/anchor identity and complete code review precede enabling
this source. Synthetic adapter interfaces are reused as protocols, not asserted
to be intrinsically safe native execution.
"""
from contextlib import contextmanager
from dataclasses import asdict
from hashlib import sha256
import os
from pathlib import Path
import shutil
import sys
import time

COHORT_PRODUCTION_ADMITTED = False


def _read(path,limit):
    from scripts.matched_baseline.offline_cohort_filesystem import _regular
    path=Path(path);before=_regular(path)
    with path.open('rb') as stream:
        opened=os.fstat(stream.fileno())
        if (opened.st_dev,opened.st_ino,opened.st_size,opened.st_mtime_ns)!=(
                before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns):
            raise ValueError('Read identity changed before open')
        raw=stream.read(limit+1);after=os.fstat(stream.fileno())
    final=_regular(path);attrs=('st_dev','st_ino','st_size','st_mtime_ns','st_ctime_ns')
    if (len(raw)>limit or any(getattr(before,k)!=getattr(final,k) for k in attrs)
            or any(getattr(opened,k)!=getattr(after,k) for k in attrs)):
        raise ValueError('Read limit/identity change')
    return raw


@contextmanager
def _components():
    if not COHORT_PRODUCTION_ADMITTED:raise RuntimeError('Native component admission held')
    from scripts.matched_baseline import offline_cohort_attempt as attempt
    from scripts.matched_baseline import offline_cohort_adapters as adapters
    from scripts.matched_baseline import offline_cohort_execution as execution
    from scripts.matched_baseline import offline_cohort_input as inputs
    from scripts.matched_baseline import offline_smoke_executor as executor
    from scripts.matched_baseline import offline_smoke_windows_assembly as windows
    flags=((attempt,'COHORT_ATTEMPT_ADMITTED'),(adapters,'COHORT_NATIVE_ADMITTED'),
        (execution,'COHORT_WIRING_ADMITTED'),(inputs,'COHORT_INPUT_ADMITTED'),
        (executor,'EXECUTION_ADMITTED'),(windows,'NATIVE_EXECUTION_ADMITTED'))
    before=[getattr(module,name) for module,name in flags]
    try:
        for module,name in flags:setattr(module,name,True)
        yield
    finally:
        for (module,name),value in zip(flags,before):setattr(module,name,value)


def load_frozen():
    if not COHORT_PRODUCTION_ADMITTED:raise RuntimeError('Frozen cohort loading held')
    from scripts.matched_baseline.offline_cohort_anchor import PACKET_PATH,PACKET_SHA256
    from scripts.matched_baseline.offline_cohort_packet import decode_packet,PACKET_LIMIT
    raw=_read(PACKET_PATH,PACKET_LIMIT)
    return decode_packet(raw,expected_sha256=PACKET_SHA256),PACKET_SHA256


def run_parent(command,approval,packet_sha256):
    if not COHORT_PRODUCTION_ADMITTED:raise RuntimeError('Authentic cohort parent held')
    from scripts.matched_baseline.offline_cohort_packet import packet_body,run_digest
    from scripts.matched_baseline.offline_cohort_contracts import encode,verify_cohort_approval
    from scripts.matched_baseline.offline_cohort_filesystem import _observe_review,_manifest,_storage,_verify_namespaces
    from scripts.matched_baseline.offline_cohort_input import read_canonical_benchmark
    from scripts.matched_baseline.offline_cohort_parent import WorkerHandoff
    from scripts.matched_baseline.offline_cohort_evidence import CohortEvidenceWriter,guard
    from scripts.matched_baseline.offline_preflight import SingleUseExecutionLock
    from scripts.matched_baseline.offline_smoke_integrity import SmokeProtectedLifecycle
    from scripts.matched_baseline.offline_smoke_boundary import BoundaryReceipt
    from scripts.matched_baseline.offline_smoke_windows_assembly import load_authentic_windows_library,DeferredCaptureJobBackend
    from scripts.matched_baseline.offline_smoke_executor import construct_boundary_backend
    from scripts.matched_baseline.offline_cohort_native import CohortJobOwner,OwnedCohortBoundary,CohortBoundaryCleanup
    from scripts.matched_baseline.offline_cohort_attempt import construct_authentic_attempt
    from scripts.matched_baseline.offline_cohort_controller import parse_fixture_cli
    review=command.launch.parent;plan=review.plan;p=review.resources;body=packet_body(command)
    roles=dict(command.launch.artifacts);root=command.launch.attempt_root
    if review.synthetic_fixture:raise ValueError('Authentic parent cannot use fixture review')
    guard(root);guard(Path(command.launch.allocation.root))
    parent_dir=command.launch.allocation.directory('parent')
    # Disjoint reserves: outer capture, child capture, <=16 boundary calls each
    # <=1 MiB output. The remaining parent share is its exclusive writer budget.
    writer_budget=command.launch.allocation.parent_bytes-2*p.capture_bytes-16*1024**2-8192
    if writer_budget<=0:raise ValueError('Parent allocation cannot fund native captures/boundary reserve')
    writer=CohortEvidenceWriter(parent_dir,budget_bytes=writer_budget)
    outer_started=time.monotonic();phase_stream=writer.new_stream('phases.jsonl',max_bytes=65536)
    poll_stream=writer.new_stream('process_polls.jsonl',max_bytes=min(writer_budget,4*1024**2))
    shutdown=Path(command.launch.allocation.root)/'outer'/'shutdown_request.json'
    def work_clock():
        if shutdown.exists():raise TimeoutError('Outer controller shutdown requested')
        return time.monotonic()
    def phase(name):
        if name!='CLEANUP':work_clock()
        phase_stream.write(encode(dict(phase=name,monotonic=time.monotonic()),1024))
    storage=lambda:_storage(evidence_root=command.launch.allocation.root,disposable_root=body['paths']['disposable'])
    integrity=SmokeProtectedLifecycle(source=plan.source_directory,cache=plan.cache_directory,
        snapshot=body['paths']['snapshot'],disposable=body['paths']['disposable'],
        source_manifest=_manifest(review,plan.source_directory),cache_manifest=_manifest(review,plan.cache_directory))
    def inventory():
        pins,roots=_observe_review(review)
        _verify_namespaces(command)
        return dict(verified_files=len(pins),verified_roots=len(roots),
            observation_sha256=sha256(encode(dict(pins=[asdict(x) for x in pins],
                roots=[asdict(x) for x in roots]),16*1024**2)).hexdigest())
    def verify_authority():
        raw=_read(command.launch.payload()['paths']['approval'],65536)
        verify_cohort_approval(raw,expected_sha256=sha256(encode(approval,65536)).hexdigest(),
            reviewed_record=approval,spec=review.spec,resources=p,reviewed_launch_binding_sha256=run_digest(command))
        return True
    boundary=None;owner=None;attempt_entered=False;authority_verified=False
    try:
        if Path(sys.executable).resolve()!=Path(roles['controller_image'].path).resolve():
            raise ValueError('Controller interpreter differs from frozen image')
        verify_authority();authority_verified=True
        with _components():
            kernel=load_authentic_windows_library(system_directory=command.system_directory,
                reviewed_system_directory=command.system_directory,expected_dll_sha256=roles['kernel32'].sha256)
            receipt=BoundaryReceipt(command.launch.rule_name,roles['firewall_image'].path,command.launch.owner_tag)
            backend=construct_boundary_backend(receipt=receipt,powershell_path=roles['powershell'].path,
                script_path=roles['boundary_script'].path,evidence_directory=parent_dir,
                environment=command.payload()['environment'],controller_pid=os.getpid())
            original_executor=backend.executor;boundary_calls=0
            def limited_boundary(argv):
                nonlocal boundary_calls
                if boundary_calls>=15:raise RuntimeError('Boundary operation count ceiling')
                remaining=p.outer_seconds-(time.monotonic()-outer_started)
                if remaining<=0:raise TimeoutError('Boundary outer deadline')
                boundary_calls+=1
                original_executor.timeout=max(.001,min(30,remaining))
                return original_executor(argv)
            backend.executor=limited_boundary
            boundary=OwnedCohortBoundary(backend,receipt,controller_pid=os.getpid())
            retained=False
            def retain():
                nonlocal retained
                if not retained:
                    writer.write_bytes('recovery_required.json',encode(dict(status='RECOVERY_REQUIRED',
                        rule=asdict(receipt),termination_confirmed=False),4096),max_bytes=4096)
                    retained=True
            cleanup=CohortBoundaryCleanup(boundary,retain_recovery=retain)
            job_backend=DeferredCaptureJobBackend(kernel,cwd=plan.workspace,
                capture_path=parent_dir/'child_output.log',clock=time.monotonic,pause=time.sleep)
            owner=CohortJobOwner(job_backend,resources=p,storage_observer=storage)
            def prepare_child(isolation):
                bench,binding=read_canonical_benchmark(spec=review.spec,
                    reviewed_pin=next(pin for pin in review.pins if pin.path==review.benchmark_path))
                handoff=WorkerHandoff(review,bench,binding).validate()
                request=encode(dict(packet_sha256=packet_sha256,isolation_receipt=asdict(isolation),
                    handoff_sha256=handoff.digest()),65536)
                writer.write_bytes('child_context.json',request,max_bytes=65536)
                return ((roles['child_image'].path,'-I','-B',roles['child_entry'].path,
                    '--cohort-child-context',body['paths']['child_context'],
                    '--context-sha256',sha256(request).hexdigest()),command.payload()['environment'])
            def intent():writer.write_bytes('boundary_intent.json',encode(dict(status='INTENT_NOT_CREATION_PROOF',
                receipt=asdict(receipt)),4096),max_bytes=4096)
            def observed(name):
                writer.write_bytes(name,encode(inventory(),4096),max_bytes=4096)
            actor=construct_authentic_attempt(resources=p,poll_seconds=command.launch.poll_seconds)
            attempt_entered=True
            return actor.run(outer_started=outer_started,clock=work_clock,pause=time.sleep,
                verify_authority=verify_authority,lock=SingleUseExecutionLock(body['paths']['single_use_lock']),
                phase=phase,inventory_before=lambda:observed('pins_before.json'),
                inventory_after=lambda:observed('pins_after.json'),free_bytes=lambda:shutil.disk_usage(root).free,
                integrity=integrity,boundary=boundary,boundary_cleanup=cleanup,record_intent=intent,
                prepare_child=prepare_child,owner=owner,storage=storage,emit=lambda row:poll_stream.write(encode(row,4096)),
                read_report=lambda:_read(command.launch.allocation.directory('child')/'cohort_report.json',p.report_bytes),
                spec=review.spec,terminal=lambda row:writer.write_bytes('terminal.json',encode(row,65536),max_bytes=65536))
    except Exception as exc:
        if authority_verified and not attempt_entered:
            checks={}
            for label,check in (('integrity',integrity.final_check),('inventory',inventory)):
                try:check();checks[label]='VERIFIED'
                except Exception as failure:checks[label]='FAIL:'+type(failure).__name__
            writer.write_bytes('setup_failure.json',encode(dict(status='FAIL',
                failure_type=type(exc).__name__,postchecks=checks),4096),max_bytes=4096)
        raise
    finally:
        writer.close()


def run_child(command,packet_sha256,argv):
    if not COHORT_PRODUCTION_ADMITTED:raise RuntimeError('Authentic cohort child held')
    from scripts.matched_baseline.offline_cohort_packet import packet_body,unique_json
    from scripts.matched_baseline.offline_cohort_contracts import digest
    from scripts.matched_baseline.offline_cohort_input import read_canonical_benchmark
    from scripts.matched_baseline.offline_cohort_parent import WorkerHandoff
    from scripts.matched_baseline.offline_preflight import IsolationReceipt,IntegrityLifecycleManager as Manager
    from scripts.matched_baseline.offline_cohort_evidence import CohortEvidenceWriter
    from scripts.matched_baseline.offline_cohort_execution import run_authentic_bound_cohort
    body=packet_body(command);review=command.launch.parent
    roles=dict(command.launch.artifacts)
    if Path(sys.executable).resolve()!=Path(roles['child_image'].path).resolve():
        raise ValueError('Child interpreter differs from frozen image')
    if (type(argv) is not list or len(argv)!=4 or argv[:3]!=[
            '--cohort-child-context',body['paths']['child_context'],'--context-sha256'] or not digest(argv[3])):
        raise ValueError('Exact child request CLI required')
    raw=_read(argv[1],65536)
    if sha256(raw).hexdigest()!=argv[3]:raise ValueError('Parent context SHA mismatch')
    request=unique_json(raw,65536)
    if (type(request) is not dict or set(request)!={'packet_sha256','isolation_receipt','handoff_sha256'}
            or request['packet_sha256']!=packet_sha256):raise ValueError('Child/frozen packet mismatch')
    isolation=IsolationReceipt(**request['isolation_receipt'])
    if (isolation.source_dir!=review.plan.source_directory
            or isolation.snapshot_dir!=body['paths']['snapshot']
            or isolation.disposable_dir!=body['paths']['disposable']):
        raise ValueError('Child copy paths differ from frozen plan')
    with _components():
        from scripts.matched_baseline.offline_cohort_filesystem import _observe_review,_verify_namespaces
        _observe_review(review);_verify_namespaces(command)
        Manager.validate_disposable_containment(receipt=isolation,candidate_dir=Path(isolation.disposable_dir),
            expected_source_dir=Path(review.plan.source_directory),pre_binding=True)
        # Verify the actual runtime image, not only the venv redirector path.
        from scripts.matched_baseline.offline_smoke_executor import construct_boundary_backend
        from scripts.matched_baseline.offline_smoke_boundary import BoundaryReceipt
        image_check=construct_boundary_backend(receipt=BoundaryReceipt(command.launch.rule_name,
            roles['firewall_image'].path,command.launch.owner_tag),powershell_path=roles['powershell'].path,
            script_path=roles['boundary_script'].path,evidence_directory=command.launch.allocation.directory('parent'),
            environment=command.payload()['environment'],controller_pid=os.getpid())
        image_check.environment(roles['firewall_image'].path)
        bench,binding=read_canonical_benchmark(spec=review.spec,
            reviewed_pin=next(pin for pin in review.pins if pin.path==review.benchmark_path))
        if WorkerHandoff(review,bench,binding).digest()!=request['handoff_sha256']:
            raise ValueError('Child observed benchmark differs from parent receipt')
        writer=CohortEvidenceWriter(command.launch.allocation.directory('child'),
                                    budget_bytes=command.launch.allocation.child_bytes)
        raw_benchmark=_read(review.benchmark_path,2*1024**2)
        return run_authentic_bound_cohort(raw=raw_benchmark,spec=review.spec,plan=review.plan,
            reviewed_plan=review.plan,receipt=isolation,resources=review.resources,writer=writer,clock=time.monotonic)


def main(argv=None):
    if not COHORT_PRODUCTION_ADMITTED:
        print('BLOCKED: cohort production packet/authority/outer launcher pending')
        return 2
    try:
        (command,approval),packet_sha=load_frozen()
        if argv and argv[0]=='--cohort-child-context':
            run_child(command,packet_sha,argv);print('COHORT CHILD COMPLETE');return 0
        from scripts.matched_baseline.offline_cohort_controller import parse_fixture_cli
        parse_fixture_cli(tuple(argv or ()),reviewed=command)
        result=run_parent(command,approval,packet_sha)
        print('COHORT PARENT OUTCOME: '+result['status'])
        return 0 if result['status']=='OFFLINE_FEASIBILITY_SUCCESS' else 1
    except Exception as exc:
        print('COHORT FAILURE TYPE: '+type(exc).__name__)
        return 1
