"""Injected budget/supervisor core. No OS imports, real adapters or live entry."""
import math
from contextlib import contextmanager
from scripts.matched_baseline.offline_cohort_contracts import encode

COHORT_EXECUTION_ADMITTED = False


def integer(value):
    return type(value) is int and value >= 0


class ByteBudget:
    def __init__(self, limit):
        if not integer(limit) or limit == 0:
            raise ValueError('Positive byte budget required')
        self.limit, self.charged = limit, 0

    def write(self, raw, sink):
        if type(raw) is not bytes or self.charged+len(raw) > self.limit:
            raise ValueError('Evidence write rejected before byte-budget breach')
        self.charged += len(raw)
        # Never refund partial/failed writes: upper-bound reservation remains.
        count = sink(raw)
        if type(count) is not int or count != len(raw):
            raise IOError('Partial evidence write; reservation retained')


def check_storage(*, resources, evidence_bytes, disposable_bytes, baseline_bytes):
    if not all(integer(v) for v in (evidence_bytes, disposable_bytes, baseline_bytes)):
        raise ValueError('Storage counters unavailable or malformed')
    if evidence_bytes > resources.evidence_bytes or max(0,disposable_bytes-baseline_bytes) > resources.disposable_growth_bytes:
        raise ValueError('Observed evidence/disposable growth exceeded budget')
    # Observation, NOT an enforced OS quota on third-party writes.


def check_free_space(*, resources, free_bytes):
    if not integer(free_bytes) or free_bytes < resources.free_space_floor_bytes:
        raise ValueError('Insufficient or unavailable pre-copy free space')


class StageTelemetry:
    """Actual injected clock observations written through a shared byte budget.
    A real composition must pass an exclusive file sink; tests use BytesIO.
    No inferred/zero-filled duration, arbitrary stage text or exception message.
    """
    STAGES = {'DENSE_BATCH','GRAPH_LOAD','CORPUS_LOAD','ROUTE_ENVELOPE','CLEANUP'}

    def __init__(self, *, clock, budget, sink):
        self.clock, self.budget, self.sink = clock, budget, sink

    @contextmanager
    def measure(self, stage, *, index=None):
        if stage not in self.STAGES or (index is not None and (not integer(index) or index >= 700)):
            raise ValueError('Invalid bounded telemetry stage/index')
        start = self.clock()
        if type(start) not in (int,float) or not math.isfinite(start):
            raise ValueError('Unavailable monotonic start time')
        completed = False
        try:
            yield
            completed = True
        finally:
            end = self.clock()
            available = type(end) in (int,float) and math.isfinite(end) and end >= start
            row = {'stage':stage,'index':index,'started_monotonic':start,
                'finished_monotonic':end if available else None,
                'elapsed_seconds':end-start if available else None,
                'timing_available':available,'computation_completed':completed}
            self.budget.write(encode(row,4096), self.sink)
            if not available:
                raise ValueError('Unavailable or backwards monotonic end time')


class CohortSupervisor:
    """Active injected loop for an already-owned child/rule. Production adapters,
    pre-child outer watchdog, writers and CLI must be separately assembled.
    Polling detects third-party growth; it cannot guarantee no overshoot or
    interrupt a blocking OS call. Telemetry sink must use shared ByteBudget.
    """
    def __init__(self, resources, *, clock, pause, emit, poll_seconds=0.25):
        resources.validate(reviewed=resources)
        if type(poll_seconds) not in (int,float) or not math.isfinite(poll_seconds) or not 0 < poll_seconds <= 1:
            raise ValueError('Bounded poll interval required')
        self.resources, self.clock, self.pause, self.emit = resources, clock, pause, emit
        self.poll_seconds = poll_seconds

    def run(self, backend, boundary, *, outer_started, child_started, baseline_bytes):
        p = self.resources
        failure = None; complete = False; confirmed = False
        last = None; peak = None; cleanup_errors = []
        try:
            for value in (outer_started, child_started):
                if type(value) not in (int,float) or not math.isfinite(value):
                    raise ValueError('Monotonic start times required')
            if child_started < outer_started or not integer(baseline_bytes):
                raise ValueError('Invalid lifecycle timing/storage baseline')
            while True:
                now = self.clock()
                if (type(now) not in (int,float) or not math.isfinite(now)
                        or now < (child_started if last is None else last)):
                    raise ValueError('Invalid monotonic observation')
                last = now
                if now-outer_started >= p.outer_seconds-p.finalization_reserve_seconds:
                    raise TimeoutError('Outer finalization reserve reached')
                if now-child_started >= p.child_seconds:
                    raise TimeoutError('Child deadline reached')
                state = backend.state()
                required = {'active_processes','root_exited','exit_code','memory_limit_hit',
                    'peak_memory_bytes','output_bytes','evidence_bytes','disposable_bytes'}
                if type(state) is not dict or set(state) != required:
                    raise ValueError('Incomplete supervision state')
                if (not integer(state['active_processes']) or type(state['root_exited']) is not bool
                        or type(state['memory_limit_hit']) is not bool
                        or (state['exit_code'] is not None and type(state['exit_code']) is not int)
                        or not integer(state['output_bytes'])):
                    raise ValueError('Malformed supervision state')
                measured = state['peak_memory_bytes']
                if measured is not None and not integer(measured):
                    raise ValueError('Malformed peak memory')
                if measured is not None:
                    peak = max(peak or 0, measured)
                self.emit({'stage':'CHILD_POLL', 'monotonic':now,
                    'peak_memory_bytes':peak, 'memory_measurement_available':measured is not None})
                if state['memory_limit_hit'] or (measured is not None and measured > p.memory_bytes):
                    raise MemoryError('Child memory ceiling reached')
                if state['output_bytes'] > p.capture_bytes:
                    raise ValueError('Child capture ceiling exceeded')
                check_storage(resources=p, evidence_bytes=state['evidence_bytes'],
                    disposable_bytes=state['disposable_bytes'], baseline_bytes=baseline_bytes)
                if state['root_exited'] and state['active_processes'] == 0:
                    confirmed = True
                    if state['exit_code'] != 0:
                        raise RuntimeError('Owned child exited unsuccessfully')
                    complete = True
                    break
                self.pause(self.poll_seconds)
        except Exception as exc:
            failure = type(exc).__name__
        finally:
            if not confirmed:
                try:
                    backend.terminate()
                except Exception as exc:
                    cleanup_errors.append('terminate:'+type(exc).__name__)
                try:
                    confirmed = backend.wait_empty(timeout_seconds=p.termination_wait_seconds) is True
                except Exception as exc:
                    cleanup_errors.append('wait:'+type(exc).__name__)
            try:
                if confirmed:
                    boundary.remove_owned_rule()
                else:
                    boundary.retain_owned_rule_for_recovery()
            except Exception as exc:
                cleanup_errors.append('boundary:'+type(exc).__name__)
            try:
                backend.close()
            except Exception as exc:
                cleanup_errors.append('close:'+type(exc).__name__)
        return {'status':'PROCESS_SUCCESS_REQUIRES_REPORT_AND_INTEGRITY_AUDIT'
            if complete and failure is None and not cleanup_errors else 'FAIL',
            'failure_type':failure,'termination_confirmed':confirmed,
            'cleanup_errors':cleanup_errors,'peak_memory_bytes':peak,
            'elapsed_child_seconds':None if last is None else last-child_started}


def main():
    print('BLOCKED: cohort production composition and frozen admission not implemented')
    return 2


if __name__ == '__main__':
    raise SystemExit(main())
