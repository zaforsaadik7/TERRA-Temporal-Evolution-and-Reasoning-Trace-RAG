+class InProcessNetworkBlocker:
+    """
+    Context manager intercepting in-process socket.socket.connect calls.
+    Raises NetworkAccessBlockedError if any socket connect attempt occurs.
+    Guarantees restoration of original socket.socket.connect in finally.
+    """
+    def __init__(self):
+        self._orig_connect = None
+
+    def __enter__(self):
+        import socket
+        self._orig_connect = socket.socket.connect
+
+        def blocked_connect(s_self, address):
+            raise NetworkAccessBlockedError(
+                f"Outbound network access blocked in offline execution: connection attempt to {address!r}"
+            )
+
+        socket.socket.connect = blocked_connect
+        return self
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        import socket
+        if self._orig_connect is not None:
+            socket.socket.connect = self._orig_connect
+            self._orig_connect = None
+        return False
+
