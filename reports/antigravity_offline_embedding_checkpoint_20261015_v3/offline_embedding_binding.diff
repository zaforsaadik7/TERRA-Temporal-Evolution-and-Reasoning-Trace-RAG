+class CleanChildEnvironmentBuilder:
+    """
+    Builds a sanitized environment dictionary for child execution processes.
+    - Strips all parent credentials and API tokens.
+    - Sets strict offline flags (HF_HUB_OFFLINE, TRANSFORMERS_OFFLINE, etc.).
+    - Never mutates or poisons the parent environment (os.environ).
+    """
+    SENSITIVE_PREFIXES = (
+        "DATABRICKS_",
+        "OPENAI_",
+        "ANTHROPIC_",
+        "AZURE_",
+        "AWS_",
+        "API_KEY",
+        "SECRET_",
+        "TOKEN_",
+        "HF_TOKEN",
+        "HUGGINGFACE_TOKEN",
+    )
+    OFFLINE_ENV_VARS = {
+        "HF_HUB_OFFLINE": "1",
+        "TRANSFORMERS_OFFLINE": "1",
+        "HF_DATASETS_OFFLINE": "1",
+        "NO_PROXY": "*",
+        "no_proxy": "*",
+        "PYTHONUNBUFFERED": "1",
+    }
+
+    @classmethod
+    def build(cls, base_env: Optional[Dict[str, str]] = None) -> Dict[str, str]:
+        source = dict(os.environ if base_env is None else base_env)
+        cleaned: Dict[str, str] = {}
+        for k, v in source.items():
+            k_upper = k.upper()
+            if any(k_upper.startswith(prefix) for prefix in cls.SENSITIVE_PREFIXES):
+                continue
+            cleaned[k] = v
+        cleaned.update(cls.OFFLINE_ENV_VARS)
+        return cleaned
+
