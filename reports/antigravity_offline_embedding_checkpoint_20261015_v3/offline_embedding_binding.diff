+    ):
+        self.rule_id = rule_id
+        self.is_synthetic = is_synthetic
+        self.command_executor = command_executor
+        self._created = False
+        self._owner_pid = os.getpid()
+
+    def create_rule(self, program_path: Path) -> None:
+        if self.is_synthetic:
+            self._created = True
+            return
+        raise NotImplementedError("Real Windows Firewall modification requires elevated administrative privileges.")
+
+    def verify_rule(self) -> bool:
+        if self.is_synthetic:
+            return self._created
+        raise NotImplementedError("Real Windows Firewall check requires elevated administrative privileges.")
+
+    def remove_rule(self) -> None:
+        if os.getpid() != self._owner_pid:
+            raise SecurityViolationError("Only the creating process can remove its firewall rule.")
+        if self.is_synthetic:
+            self._created = False
+            return
+        raise NotImplementedError("Real Windows Firewall removal requires elevated administrative privileges.")
+
+    def get_manual_recovery_command(self) -> str:
+        return f'netsh advfirewall firewall delete rule name="{self.rule_id}"'
