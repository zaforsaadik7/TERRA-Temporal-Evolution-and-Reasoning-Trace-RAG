+class WindowsFirewallManager:
+    """
+    Interface for outbound Windows Firewall rules for offline execution isolation.
+    - Generates unique rule ID with ownership tracking.
+    - Fails closed on rule collision before creation.
+    - Verifies rule presence and attributes.
+    - Teardown restricted to owning process.
+    - Generates manual recovery command if automated teardown fails.
+    - In test/mock mode, operates synthetically without changing Windows Firewall.
+    """
+    def __init__(
+        self,
+        rule_id: str,
+        is_synthetic: bool = True,
