"""Benchmark-byte binding and held cohort worker composition.

Input matching and report labels are not execution permission or provenance
certificates. Real entry remains blocked pending parent admission/supervision.
"""
from dataclasses import dataclass
from hashlib import sha256
import json
from scripts.matched_baseline.offline_cohort_adapters import (
    compose_dependency_factories, genuine_runtime)
from scripts.matched_baseline.offline_cohort_assembly import CohortAssembly
from scripts.matched_baseline.offline_cohort_worker import (
    PreparedCohortWorker, _CohortComputation)
from scripts.matched_baseline.offline_cohort_contracts import encode
from scripts.matched_baseline.offline_cohort_controls import StageTelemetry

COHORT_WIRING_ADMITTED = False
MAX_BENCHMARK_BYTES = 2*1024**2


def _unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError('Duplicate benchmark JSON key')
        result[key] = value
    return result


@dataclass(frozen=True)
class BenchmarkBinding:
    source_path: str
    content_sha256: str
    size_bytes: int
    query_pairs: tuple
    synthetic_fixture: bool


def bind_benchmark_bytes(raw, *, spec, reviewed_sha256, is_synthetic=True):
    """Validate the exact bytes supplied, never reopen a hash-then-parse file.

    Caller supplies a separately reviewed digest; in genuine mode only canonical
    spec digest is accepted. No source file, answer or gold field is returned.
    Fixture digest is deliberately distinguished from actual pinned benchmark.
    """
    spec.validate()
    if type(is_synthetic) is not bool:
        raise ValueError('Exact benchmark binding mode required')
    if (type(raw) is not bytes or not 0 < len(raw) <= MAX_BENCHMARK_BYTES
            or type(reviewed_sha256) is not str
            or sha256(raw).hexdigest() != reviewed_sha256):
        raise ValueError('Benchmark bytes/digest mismatch')
    if not is_synthetic and reviewed_sha256 != spec.benchmark_sha256:
        raise ValueError('Authentic benchmark must match canonical pin')
    rows = json.loads(raw.decode('utf-8'), object_pairs_hook=_unique_object,
        parse_constant=lambda value:(_ for _ in ()).throw(ValueError('Nonfinite benchmark JSON')))
    if type(rows) is not list or len(rows) != 350:
        raise ValueError('Exact benchmark population required')
    pairs = []
    for identity, row in zip(spec.queries, rows):
        if (type(row) is not dict or row.get('query_id') != identity.query_id
                or row.get('category') != identity.category
                or type(row.get('query')) is not str or not row['query'].strip()
                or sha256(row['query'].encode()).hexdigest() != identity.text_sha256):
            raise ValueError('Benchmark identity/category/text mismatch')
        pairs.append((identity.query_id, row['query']))
    return BenchmarkBinding(spec.benchmark_path,reviewed_sha256,len(raw),tuple(pairs),is_synthetic)


class AuthenticCohortComputation(_CohortComputation):
    def __init__(self, **dependencies):
        if not COHORT_WIRING_ADMITTED:
            raise RuntimeError('Authentic cohort computation remains blocked')
        self._configure(**dependencies, mode='AUTHENTIC_OFFLINE_FEASIBILITY')


def _close_writer(writer, original=None):
    try:
        writer.close()
    except BaseException as cleanup:
        if original is not None:
            raise BaseExceptionGroup('Cohort failure and writer cleanup failure',
                                     [original, cleanup])
        raise


def _run_bound(*, binding, spec, plan, reviewed_plan, receipt, resources,
               runtime, writer, clock, guard, worker_factory):
    """Trusted composition core; public entries choose factory and label.

    An existing report file records computation only. A cleanup/guard-exit error
    prevents successful return; parent terminal success still needs integrity
    and confirmed child exit. This function does not own/delete firewall rules.
    """
    original=None
    try:
        telemetry_stream=writer.new_stream('telemetry.jsonl',max_bytes=resources.evidence_bytes)
        rows=writer.new_stream('query_records.jsonl',max_bytes=resources.report_bytes)
        telemetry=StageTelemetry(clock=clock,budget=writer.budget,sink=telemetry_stream._write_reserved)
        with guard():
            dependencies=compose_dependency_factories(plan=plan,runtime=runtime)
            with CohortAssembly(plan=plan,reviewed_plan=reviewed_plan,dependencies=dependencies) as assembly:
                prepared=assembly.load(spec=spec,query_pairs=list(binding.query_pairs),receipt=receipt)
                worker=worker_factory(**prepared,resources=resources,telemetry=telemetry)
                report=worker.run(spec,list(binding.query_pairs),on_record=rows.write)
                writer.write_bytes('cohort_report.json',report,max_bytes=resources.report_bytes)
        return report
    except BaseException as exc:
        original=exc
        try:
            writer.write_bytes('failure.json',encode({'status':'FAILED_INCOMPLETE',
                'failure_type':type(exc).__name__},1024),max_bytes=1024)
        except Exception:
            pass
        raise
    finally:
        _close_writer(writer,original)


def run_synthetic_bound_cohort(*, raw, spec, reviewed_sha256, plan, reviewed_plan,
        receipt, resources, runtime, writer, clock, guard, is_synthetic=True):
    if is_synthetic is not True:
        raise RuntimeError('Synthetic cohort composition cannot admit genuine execution')
    try:
        binding=bind_benchmark_bytes(raw,spec=spec,reviewed_sha256=reviewed_sha256)
    except BaseException as original:
        _close_writer(writer,original)
        raise
    return _run_bound(binding=binding,spec=spec,plan=plan,reviewed_plan=reviewed_plan,
        receipt=receipt,resources=resources,runtime=runtime,writer=writer,clock=clock,
        guard=guard,worker_factory=PreparedCohortWorker)


def run_authentic_bound_cohort(*, raw, spec, plan, reviewed_plan, receipt,
                              resources, writer, clock):
    # No caller-provided report mode, runtime factory or network guard accepted.
    if not COHORT_WIRING_ADMITTED:
        raise RuntimeError('Authentic cohort execution wiring remains blocked')
    from scripts.matched_baseline.offline_preflight import InProcessNetworkBlocker
    try:
        binding=bind_benchmark_bytes(raw,spec=spec,reviewed_sha256=spec.benchmark_sha256,
                                     is_synthetic=False)
        runtime=genuine_runtime()
    except BaseException as original:
        _close_writer(writer,original)
        raise
    return _run_bound(binding=binding,spec=spec,plan=plan,reviewed_plan=reviewed_plan,
        receipt=receipt,resources=resources,runtime=runtime,writer=writer,
        clock=clock,guard=InProcessNetworkBlocker,worker_factory=AuthenticCohortComputation)


def main():
    print('BLOCKED: cohort input inventory and parent execution admission pending')
    return 2


if __name__ == '__main__':
    raise SystemExit(main())
