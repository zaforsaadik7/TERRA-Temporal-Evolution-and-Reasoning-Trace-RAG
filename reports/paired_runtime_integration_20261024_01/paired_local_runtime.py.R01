"""Link verified local dependency assembly to paired retrieval. Genuine gate held.

Reuses the offline cohort's receipt-aware, explicit-embedding loader. A future
authentic packet must admit all of that loader's existing gates independently;
this module never flips them or substitutes synthetic assets for authentic ones.
"""
from dataclasses import dataclass

from .paired_dependency_bridge import RetrievalComposition, ROLES
from .provider_accounting import ContractError, DispatchHeld


@dataclass
class PairedLocalBundle:
    retrieval: object
    tokenizers: dict
    close: object


def _assemble_local(*, assembly, spec, query_pairs, receipt, expected_count):
    """Trusted assembly seam. Caller owns independent path/receipt admission.

    Genuine use must require expected_count=20000, not the tiny fixture counts.
    Assembly owns all partial allocations; bundle close releases its references.
    Release is not proof of native shutdown: the dedicated child must exit.
    """
    try:
        loaded = assembly.load(spec=spec, query_pairs=query_pairs, receipt=receipt)
        if type(loaded) is not dict or set(loaded) != {'reader', 'nodes', 'edges', 'role_configs'}:
            raise ContractError('Exact local dependency bundle required')
        roles = loaded['role_configs']
        if type(roles) is not dict or set(roles) != set(ROLES):
            raise ContractError('Five local tokenizer roles required')
        tokens = {role: roles[role].tokenizer for role in ROLES}
        if tokens['generator'] is not tokens['verifier']:
            raise ContractError('Generator/verifier tokenizer identity must match')
        corpus = loaded['reader'].extract_layer1_corpus(expected_count=expected_count)
        if len(corpus) != expected_count or len(loaded['nodes']) != expected_count:
            raise ContractError('Local corpus population mismatch')
        retrieval = RetrievalComposition(loaded['reader'], corpus, loaded['nodes'], loaded['edges'])
        return PairedLocalBundle(retrieval, tokens, assembly.close)
    except BaseException as original:
        try:
            assembly.close()
        except BaseException as cleanup:
            raise BaseExceptionGroup('Local loading and cleanup failed', [original, cleanup])
        raise


def load_authentic_local(*args, **kwargs):
    # Before imports that could load numpy/Chroma/tokenizers and before paths.
    raise DispatchHeld('Authentic local study dependency loading is not admitted')


def _construct_authentic_local(*, plan, reviewed_plan, spec, query_pairs, receipt):
    """Source for future reviewed admission, unreachable from the held entry.

    Existing genuine_runtime() has its own source hold. No gate is overridden.
    The expected source comes from reviewed_plan, not the candidate receipt.
    """
    from .offline_cohort_adapters import genuine_runtime, compose_dependency_factories
    from .offline_cohort_assembly import CohortAssembly
    dependencies = compose_dependency_factories(plan=plan, runtime=genuine_runtime(), is_synthetic=True)
    assembly = CohortAssembly(plan=plan, reviewed_plan=reviewed_plan,
                               dependencies=dependencies, is_synthetic=True)
    return _assemble_local(assembly=assembly, spec=spec, query_pairs=query_pairs,
                           receipt=receipt, expected_count=20000)
