+    """
+    if type(bundle) is not PairedLocalBundle:
+        raise ContractError('Owned paired local bundle required')
+    try:
+        from .paired_study_runtime import _run_bound_study
+        result = _run_bound_study(root=root,queries=queries,retrieval=bundle.retrieval,
+            tokenizers=bundle.tokenizers,configs=configs,quotas=quotas,
+            connection_factory=connection_factory,bearer=bearer,
+            cap_nanodollars=cap_nanodollars,byte_cap=byte_cap,mode=mode,**controls)
+    except BaseException as original:
+        try:bundle.close()
+        except BaseException as cleanup:
+            raise BaseExceptionGroup('Study and local cleanup failed',[original,cleanup])
+        raise
+    bundle.close()
+    return result
