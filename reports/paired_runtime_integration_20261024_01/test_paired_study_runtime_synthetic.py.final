"""End-to-end held study wiring with static HTTP and temporary files only."""
from dataclasses import replace
import copy
import json
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch, Mock

from tests import test_paired_dependency_bridge_synthetic as fixtures
from scripts.matched_baseline.provider_accounting import (
    canonical, strict_json, BudgetJournal, ContractError, DispatchHeld,
)
from scripts.matched_baseline.provider_run_control import (
    StaticConnection, HttpFixture, EndpointQuota,
)
from scripts.matched_baseline.paired_study_runtime import (
    StudyQuery, StudyStore, _run_bound_study, run_authentic_study,
    validate_composed_result,
)


class RuntimeTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)/'run'
        self.f = fixtures.BridgeTests('runTest')
        self.f.setUp()
        self.connections = []
        self.factories = []
        self.bad_stage = None
        self.fail_stage = None
        self.quota = {r: EndpointQuota(1000000, 1000000, 10000) for r in self.f.configs}

    def connection(self, config):
        self.factories.append(config.role)
        stage = config.role
        content = ({'route': 'HARD'} if stage == 'router' else
            {'sufficient': self.f.sufficient, 'reason': 'fixture'} if stage == 'verifier' else
            'synthetic generated answer' if stage == 'generator' else
            {'faithfulness': None if self.f.null else 0.5,
             'outcome': 'SUBSTANTIVE_ANSWER', 'rationale': 'fixture'})
        if stage == self.bad_stage: content = {'invalid': 'fixture'}
        body = canonical({'id': 'fixture', 'model': 'fixture-model',
            'choices': [{'finish_reason': 'stop', 'message': {'role': 'assistant',
                'content': content if type(content) is str else json.dumps(content)}}],
            'usage': {'prompt_tokens': 10, 'completion_tokens': 10, 'total_tokens': 20}})
        connection = StaticConnection(HttpFixture(body=body,
            fail_at='request' if stage == self.fail_stage else None))
        self.connections.append(connection)
        return connection

    def run_study(self, **overrides):
        opts = dict(root=self.root,
            queries=(StudyQuery('Q001', 'alpha', 'B_Evolutionary'),),
            retrieval=self.f.retrieval, tokenizers=self.f.tokenizers,
            configs=self.f.configs, quotas=self.quota,
            connection_factory=self.connection, bearer=lambda:'SYNTHETIC_NOT_A_CREDENTIAL',
            cap_nanodollars=10000000, byte_cap=16*1024**2,
            now=lambda:0, mode='SYNTHETIC_DEPENDENCY_COMPOSITION')
        opts.update(overrides)
        return _run_bound_study(**opts)

    def test_complete_pair_http_usage_and_manifest(self):
        result = self.run_study()
        self.assertEqual(result['completed'], 1)
        self.assertEqual(len(self.connections), 9)
        self.assertTrue(all(c.closed for c in self.connections))
        terminal = strict_json((self.root/'terminal.json').read_bytes())
        self.assertEqual(terminal['status'], 'COMPUTATION_COMPLETE_REQUIRES_POSTRUN_AUDIT')
        self.assertFalse(terminal['execution_authority'])
        self.assertEqual(len(BudgetJournal.inspect(self.root/'calls.jsonl')['states']), 9)

    def test_refusal_and_null_reconstruct_without_score_invention(self):
        self.f.sufficient = False
        self.f.null = True
        self.run_study()
        result = strict_json((self.root/'Q001.json').read_bytes())
        self.assertIsNone(result['arms']['H']['composite'])
        self.assertNotIn('generator', self.factories)
        self.assertEqual(len(self.connections), 7)

    def test_two_queries_serial_order_same_pipeline(self):
        self.run_study(queries=(StudyQuery('Q001','alpha','B_Evolutionary'),
                                StudyQuery('Q002','beta','A_Factual')))
        self.assertEqual(len(self.connections), 18)
        terminal = strict_json((self.root/'terminal.json').read_bytes())
        self.assertEqual(terminal['count'], 2)

    def test_authentic_entry_fails_before_files_or_callbacks(self):
        callback = Mock(side_effect=AssertionError())
        with self.assertRaises(DispatchHeld):
            run_authentic_study(root=self.root, bearer=callback)
        self.assertFalse(self.root.exists())
        callback.assert_not_called()

    def test_timeout_retains_exposure_and_no_retry(self):
        self.fail_stage = 'router'
        with self.assertRaises(TimeoutError): self.run_study()
        evidence = BudgetJournal.inspect(self.root/'calls.jsonl')
        self.assertEqual(len(self.connections), 1)
        self.assertEqual(evidence['states']['Q001:shared:router'], 'UNCERTAIN')
        self.assertTrue((self.root/'single_attempt.lock').exists())
        self.assertEqual(strict_json((self.root/'terminal.json').read_bytes())['status'], 'FAIL')

    def test_invalid_content_still_settled_and_no_result(self):
        self.bad_stage = 'router'
        with self.assertRaises(ContractError): self.run_study()
        entry = BudgetJournal.inspect(self.root/'calls.jsonl')['states']['Q001:shared:router']
        self.assertEqual(entry, 'SETTLE')
        self.assertFalse((self.root/'Q001.json').exists())

    def test_record_fsync_failure_prevents_network(self):
        original = StudyStore.record
        def fail(store, event):
            if event.get('kind') == 'HTTP_REQUEST': raise OSError('fixture disk')
            return original(store, event)
        with patch.object(StudyStore, 'record', fail), self.assertRaises(OSError):
            self.run_study()
        self.assertEqual(self.connections, [])
        self.assertEqual(BudgetJournal.inspect(self.root/'calls.jsonl')['states']['Q001:shared:router'], 'UNCERTAIN')

    def test_tampered_pair_rejected_before_publish(self):
        original = StudyStore.save_pair
        def tamper(store, query, pair, journal):
            value = copy.deepcopy(pair)
            value['arms']['H']['composite'] = 1
            return original(store, query, value, journal)
        with patch.object(StudyStore, 'save_pair', tamper), self.assertRaises(ContractError):
            self.run_study()
        self.assertFalse((self.root/'Q001.json').exists())

    def test_coherent_trace_score_tamper_still_rejected_by_response(self):
        original = StudyStore.save_pair
        def tamper(store, query, pair, journal):
            pair['arms']['H']['composite'] = 1
            # store.rows completion contains the same pair object. Reconstruction
            # must still fail against the raw provider HTTP response.
            return original(store, query, pair, journal)
        with patch.object(StudyStore, 'save_pair', tamper), self.assertRaises(ContractError):
            self.run_study()

    def test_namespace_collision_before_creation(self):
        with self.assertRaises(ContractError): StudyStore(self.root, ('CON',), 8192)
        self.assertFalse(self.root.exists())

    def test_repeat_directory_never_adopted(self):
        self.run_study()
        before = (self.root/'terminal.json').read_bytes()
        with self.assertRaises(FileExistsError): self.run_study()
        self.assertEqual(before, (self.root/'terminal.json').read_bytes())

    def test_tiny_aggregate_cap_stops_before_connection(self):
        with self.assertRaises(ContractError): self.run_study(byte_cap=16384)
        self.assertEqual(self.connections, [])

    def test_budget_exhaustion_stops_before_secret_or_connection(self):
        config = self.f.configs['router']
        self.f.configs['router'] = replace(config, price=replace(config.price, input_per_million=1000000))
        secret = Mock(side_effect=AssertionError('not expected'))
        with self.assertRaises(DispatchHeld): self.run_study(cap_nanodollars=1, bearer=secret)
        self.assertEqual(self.connections, [])
        secret.assert_not_called()

    def test_generator_verifier_share_endpoint_quota(self):
        self.f.configs['verifier'] = replace(self.f.configs['verifier'], endpoint='generator')
        self.quota['generator'] = EndpointQuota(8000, 10000, 1000)
        self.quota['verifier'] = self.quota['generator']
        with self.assertRaises(DispatchHeld): self.run_study()
        self.assertLess(len(self.connections), 9)

    def test_gpt_request_and_local_template_both_bind_low_reasoning(self):
        config=self.f.configs['judge2']
        self.f.configs['judge2']=replace(config,endpoint='databricks-gpt-oss-120b')
        tokenizer=self.f.tokenizers['judge2']
        original=tokenizer.apply_chat_template
        observed=[]
        def render(msgs,add_generation_prompt=True,**kwargs):
            observed.append(kwargs)
            return original(msgs,add_generation_prompt=add_generation_prompt)
        tokenizer.apply_chat_template=render
        self.run_study()
        gpt=[c for c in self.connections if 'gpt-oss' in c.requests[0][1]]
        self.assertEqual(len(gpt),2)
        self.assertTrue(all(json.loads(c.requests[0][2])['reasoning_effort']=='low' for c in gpt))
        self.assertTrue(all(k=={'reasoning_effort':'low'} for k in observed))


if __name__ == '__main__':
    unittest.main()
