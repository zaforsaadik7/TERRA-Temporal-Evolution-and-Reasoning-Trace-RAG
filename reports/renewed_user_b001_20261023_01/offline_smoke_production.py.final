"""Frozen-packet production integration. Entry admission is DISABLED.

No real packet/authorization is supplied by this source file. Task 3 must freeze
the packet identity and review the complete code before any execution decision.
"""
from contextlib import contextmanager
from dataclasses import asdict
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import time

ENTRY_ADMITTED = True
MODE = 'AUTHENTIC_OFFLINE_FEASIBILITY'
STATUS = 'OFFLINE_FEASIBILITY_SUCCESS'


def _json(raw):
    def unique(pairs):
        result = {}
        for key,value in pairs:
            if key in result:
                raise ValueError('Duplicate packet/context field')
            result[key] = value
        return result
    return json.loads(raw.decode('utf-8'),object_pairs_hook=unique,
        parse_constant=lambda value: (_ for _ in ()).throw(ValueError('Nonfinite packet')))


def _read(path,limit):
    from scripts.matched_baseline.offline_preflight import IntegrityLifecycleManager as Manager
    path = Path(path)
    if not path.is_absolute():
        raise ValueError('Absolute packet artifact path required')
    Manager.check_symlink_and_reparse_containment(path)
    if not path.is_file():
        raise ValueError('Ordinary packet artifact required')
    with path.open('rb') as stream:
        raw = stream.read(limit+1)
    if len(raw)>limit:
        raise ValueError('Packet artifact byte limit exceeded')
    return raw


def decode_packet(raw,expected_sha256):
    if type(raw) is not bytes or len(raw)>8*1024*1024 or type(expected_sha256) is not str or not re.fullmatch('[0-9a-f]{64}',expected_sha256) or hashlib.sha256(raw).hexdigest()!=expected_sha256:
        raise ValueError('Frozen packet digest/type/size mismatch')
    packet = _json(raw)
    fields = {'schema_version','controller_interpreter','config','reviewed_context','load_plan','integrity',
        'declared_files','approval_path','reviewed_approval','owner_tag','windows','runtime_environment'}
    if type(packet) is not dict or set(packet)!=fields or type(packet['schema_version']) is not int or packet['schema_version']!=1:
        raise ValueError('Unsupported frozen packet schema')
    from scripts.matched_baseline.offline_smoke_config import SmokeLaunchConfig
    from scripts.matched_baseline.offline_smoke_authentic import AuthenticLoadPlan
    values = dict(packet['config'])
    values['command'] = tuple(values['command'])
    values['pins'] = tuple(tuple(pair) for pair in values['pins'])
    values['hypothetical_routes'] = tuple(values['hypothetical_routes'])
    config = SmokeLaunchConfig(**values)
    config.validate(**packet['reviewed_context'])
    if config.firewall_program is None:
        raise ValueError('Explicit reviewed runtime firewall image required')
    if 'reviewed_controller_policy' not in packet['reviewed_context']:
        raise ValueError('Explicit reviewed controller policy required')
    plan = AuthenticLoadPlan(**packet['load_plan'])
    if plan.expected_documents!=config.expected_documents or plan.expected_documents!=20000 or plan.seed_k!=2 or plan.expected_graph_sha256!=dict(config.pins)['graph']:
        raise ValueError('Load plan/config identity mismatch')
    request_path = str(Path(config.evidence_directory)/'child_request.json')
    expected_command = (config.command[0],'-B','-m',
        'scripts.matched_baseline.offline_smoke_child_entry','--request',request_path)
    if config.command!=expected_command:
        raise ValueError('Production child command differs from fixed entry')
    if type(packet['owner_tag']) is not str or not packet['owner_tag']:
        raise ValueError('Boundary owner tag required')
    integrity = packet['integrity']
    if set(integrity)!={'source','cache','snapshot','disposable','source_manifest','cache_manifest'} or integrity['cache']!=plan.cache_directory:
        raise ValueError('Incomplete integrity paths/inventories')
    for path in [plan.workspace,plan.cache_directory,plan.graph_archive,plan.tokenizer_directory,
                 packet['approval_path'],packet['controller_interpreter'],integrity['source'],integrity['snapshot'],integrity['disposable']]:
        if type(path) is not str or not Path(path).is_absolute() or '..' in Path(path).parts:
            raise ValueError('Invalid production path')
    if set(packet['windows'])!={'system_directory','kernel32_sha256','powershell_path','script_path'}:
        raise ValueError('Incomplete native Windows bindings')
    from scripts.matched_baseline.offline_preflight import CleanChildEnvironmentBuilder
    environment = packet['runtime_environment']
    if type(environment) is not dict or any(type(key) is not str or type(value) is not str or
            key.upper() not in CleanChildEnvironmentBuilder.SAFE_ALLOWLIST_KEYS or
            key.upper() in {'PYTHONPATH','PYTHONHOME'} or '\0' in key+value for key,value in environment.items()) or (
            len(environment)!=len({key.upper() for key in environment})):
        raise ValueError('Unreviewed runtime environment keys')
    return packet,config,plan


def load_frozen_packet():
    if not ENTRY_ADMITTED:
        raise RuntimeError('Production entries not admitted')
    from scripts.matched_baseline.offline_smoke_entry_anchor import PACKET_PATH,PACKET_SHA256
    return decode_packet(_read(PACKET_PATH,8*1024*1024),PACKET_SHA256)


def verify_packet_inputs(packet,config):
    from scripts.matched_baseline.offline_smoke_file_pins import FrozenFilePinVerifier
    from scripts.matched_baseline.offline_smoke_approval import verify_approval_bytes
    files = packet['declared_files']
    if type(files) is not dict or any(type(item) is not dict or set(item) not in (
            {'path','sha256','size_bytes'}, {'path','sha256','size_bytes','members'}) for item in files.values()):
        raise ValueError('Invalid constituent file inventory')
    verifier = FrozenFilePinVerifier(file_paths={k:v['path'] for k,v in files.items()},
        expected_pins={k:v['sha256'] for k,v in files.items()},expected_sizes={k:v['size_bytes'] for k,v in files.items()},
        manifest_specs={k:v['members'] for k,v in files.items() if 'members' in v})
    if verifier.pins!=dict(config.pins):
        raise ValueError('Constituent inventory/config mismatch')
    # The entry anchor is the separately reviewed trust root, not a constituent
    # of the packet whose digest it contains (which would create a hash cycle).
    required_paths = {str(Path(__file__).absolute()),str(Path(packet['load_plan']['graph_archive'])),
        config.command[0],config.firewall_program,packet['controller_interpreter'],packet['windows']['powershell_path'],packet['windows']['script_path'],
        str(Path(packet['windows']['system_directory'])/'kernel32.dll')}
    verifier.verify()
    if not {Path(path).resolve() for path in required_paths}.issubset(verifier.verified_paths):
        raise ValueError('Missing referenced production constituent')
    approval = _read(packet['approval_path'],65536)
    verify_approval_bytes(approval,expected_sha256=config.authorization_sha256,
        reviewed_record=packet['reviewed_approval'],config=config)
    return verifier,approval


@contextmanager
def _components():
    if not ENTRY_ADMITTED:
        raise RuntimeError('Production component activation not admitted')
    from scripts.matched_baseline import offline_smoke_authentic as worker
    from scripts.matched_baseline import offline_smoke_windows_assembly as windows
    from scripts.matched_baseline import offline_smoke_executor as executor
    prior = worker.PRODUCTION_ADMITTED,windows.NATIVE_EXECUTION_ADMITTED,executor.EXECUTION_ADMITTED
    try:
        worker.PRODUCTION_ADMITTED = windows.NATIVE_EXECUTION_ADMITTED = executor.EXECUTION_ADMITTED = True
        yield
    finally:
        worker.PRODUCTION_ADMITTED,windows.NATIVE_EXECUTION_ADMITTED,executor.EXECUTION_ADMITTED = prior


def _request_matches(request,packet,config,plan):
    from scripts.matched_baseline.offline_preflight import IsolationReceipt, IntegrityLifecycleManager as Manager
    expected = {'scope':config.scope,'query_id':config.query_id,
        'query_text':packet['reviewed_context']['query_text'],'query_text_sha256':config.query_text_sha256,
        'authorization_id':config.authorization_id,'authorization_sha256':config.authorization_sha256,
        'protected_pins':dict(config.pins),'seed_k':plan.seed_k,'expected_documents':config.expected_documents,
        'limits':{'timeout_seconds':config.timeout_seconds,'memory_bytes':config.memory_bytes,'output_limit_bytes':config.output_limit_bytes}}
    payload = request.to_payload()
    if any(payload[key]!=value for key,value in expected.items()):
        raise ValueError('Child request differs from frozen packet')
    receipt = IsolationReceipt(**request.isolation_receipt)
    integrity = packet['integrity']
    if any(Path(getattr(receipt,key)).resolve()!=Path(integrity[key.replace('_dir','')]).resolve()
           for key in ('source_dir','snapshot_dir','disposable_dir')):
        raise ValueError('Child receipt directory mismatch')
    Manager.validate_disposable_containment(receipt=receipt,candidate_dir=Path(integrity['disposable']),
        expected_source_dir=Path(integrity['source']),pre_binding=True)
    return receipt


def _dispatch(packet,config,plan,kernel,writer):
    used = False
    def invoke(receipt,capture,child_config,environment):
        nonlocal used
        if used:
            raise RuntimeError('Production child retry forbidden')
        used = True
        from scripts.matched_baseline.offline_smoke_lifecycle import ChildExecutionFailure,ChildProcessResult
        from scripts.matched_baseline.offline_smoke_request import SmokeChildRequest
        from scripts.matched_baseline.offline_smoke_child_entry import encode_child_context
        from scripts.matched_baseline.offline_smoke_windows_assembly import assemble_windows_dispatch
        dispatch = None
        try:
            if child_config is not config:
                raise ValueError('Production dispatch config mismatch')
            path = writer.directory/'child_request.json'
            raw = _read(path,1024*1024)
            request = SmokeChildRequest.from_bytes(raw)
            checked = _request_matches(request,packet,config,plan)
            if checked!=receipt:
                raise ValueError('Parent receipt mismatch')
            context,digest = encode_child_context(request_path=path,
                request_sha256=hashlib.sha256(raw).hexdigest(),reviewed_context=request.to_payload())
            writer._write_bytes('child_context.json',context)
            env = dict(environment)
            if any(key.upper()=='TERRA_SMOKE_CONTEXT_SHA256' for key in env):
                raise ValueError('Inherited context digest override')
            env['TERRA_SMOKE_CONTEXT_SHA256'] = digest
            dispatch = assemble_windows_dispatch(kernel=kernel,cwd=plan.workspace,capture_path=capture,
                config=config,clock=time.monotonic,pause=time.sleep)
            dispatch.expected_mode = MODE
            return dispatch(receipt,capture,config,env)
        except ChildExecutionFailure:
            raise
        except Exception as exc:
            if dispatch is None or not dispatch.used:
                raise ChildExecutionFailure('Prelaunch context/dispatch failure: '+type(exc).__name__,
                    ChildProcessResult(True,None)) from exc
            raise
    return invoke


def run_parent(packet,config,plan):
    if not ENTRY_ADMITTED:
        raise RuntimeError('Production parent execution not admitted')
    controller = Path(packet['controller_interpreter']).resolve()
    if controller!=Path(sys.executable).resolve():
        raise ValueError('Frozen controller must match this process')
    if not config.firewall_program:
        raise ValueError('Explicit runtime firewall image required')
    from scripts.matched_baseline.offline_preflight import ManifestEntry,SingleUseExecutionLock,IntegrityLifecycleManager as Manager
    from scripts.matched_baseline.offline_smoke_integrity import SmokeProtectedLifecycle
    from scripts.matched_baseline.offline_smoke_boundary import OwnedSmokeBoundary,BoundaryReceipt
    from scripts.matched_baseline.offline_smoke_evidence import SmokeEvidenceWriter
    from scripts.matched_baseline.offline_smoke_runner import SmokeRunner
    from scripts.matched_baseline.offline_smoke_windows_assembly import load_authentic_windows_library
    from scripts.matched_baseline.offline_smoke_executor import construct_boundary_backend
    verifier,approval = verify_packet_inputs(packet,config)
    values = dict(packet['integrity'])
    for key in ('source_manifest','cache_manifest'):
        values[key] = {name:ManifestEntry(**entry) for name,entry in values[key].items()}
    integrity = SmokeProtectedLifecycle(**values)
    Manager.check_symlink_and_reparse_containment(Path(config.evidence_directory).parent)
    writer = SmokeEvidenceWriter(Path(config.evidence_directory),success_status=STATUS)
    try:
        with _components():
            windows = packet['windows']
            kernel = load_authentic_windows_library(system_directory=windows['system_directory'],
                reviewed_system_directory=windows['system_directory'],expected_dll_sha256=windows['kernel32_sha256'])
            receipt = BoundaryReceipt(config.rule_name,config.firewall_program,packet['owner_tag'])
            backend = construct_boundary_backend(receipt=receipt,powershell_path=windows['powershell_path'],
                script_path=windows['script_path'],evidence_directory=writer.directory,
                environment=packet['runtime_environment'],controller_pid=os.getpid())
            runner = SmokeRunner(config=config,reviewed_context=packet['reviewed_context'],integrity=integrity,
                boundary=OwnedSmokeBoundary(backend,receipt,controller_pid=os.getpid()),writer=writer,
                execution_lock=SingleUseExecutionLock(config.lock_path),
                execute_child=_dispatch(packet,config,plan,kernel,writer),approval_bytes=approval,
                reviewed_approval=packet['reviewed_approval'],runtime_environment=packet['runtime_environment'],
                file_verifier=verifier,report_mode=MODE)
            return runner.run()
    except Exception as exc:
        if not writer.started:
            checks = {}
            for name,check in (('protected_directories',integrity.final_check),('declared_files',verifier.verify)):
                try:
                    check(); checks[name] = 'VERIFIED'
                except Exception as failure:
                    checks[name] = 'FAIL:'+type(failure).__name__
            writer._write_json('parent_setup_failure.json',{'status':'FAIL','error_type':type(exc).__name__,
                'postchecks':checks,'child_launched':False})
        raise


def _verify_child_runtime_image(packet,config):
    # Verify the actual child image, not sys.executable / a venv redirector.
    # This read-only adapter operation cannot create/remove a firewall rule.
    from scripts.matched_baseline.offline_smoke_executor import construct_boundary_backend
    from scripts.matched_baseline.offline_smoke_boundary import BoundaryReceipt
    windows = packet['windows']
    backend = construct_boundary_backend(
        receipt=BoundaryReceipt(config.rule_name,config.firewall_program,packet['owner_tag']),
        powershell_path=windows['powershell_path'],script_path=windows['script_path'],
        evidence_directory=config.evidence_directory,environment=packet['runtime_environment'],
        controller_pid=os.getpid())
    backend.environment(config.firewall_program)


def run_child(argv,packet,config,plan,environment):
    if not ENTRY_ADMITTED:
        raise RuntimeError('Production child execution not admitted')
    verify_packet_inputs(packet,config)
    from scripts.matched_baseline.offline_smoke_child_entry import execute_context_cli
    from scripts.matched_baseline.offline_smoke_authentic import construct_authentic_worker
    digest = environment.get('TERRA_SMOKE_CONTEXT_SHA256')
    if type(digest) is not str or not re.fullmatch('[0-9a-f]{64}',digest):
        raise ValueError('Missing independent parent context digest')
    context = _read(Path(config.evidence_directory)/'child_context.json',2*1024*1024)
    def loader(request):
        receipt = _request_matches(request,packet,config,plan)
        _verify_child_runtime_image(packet,config)
        return construct_authentic_worker(plan,receipt,{'scope':config.scope,'mode':MODE})
    with _components():
        return execute_context_cli(argv,context_bytes=context,expected_context_sha256=digest,
            worker_loader=loader,expected_mode=MODE)


def parent_main(argv=None):
    if not ENTRY_ADMITTED:
        print('BLOCKED: production parent packet/admission pending')
        return 2
    try:
        if (sys.argv[1:] if argv is None else argv)!=[]:
            raise ValueError('Frozen parent takes no arguments')
        packet,config,plan = load_frozen_packet()
        outcome = run_parent(packet,config,plan)
        print('PARENT OUTCOME: '+outcome.status)
        print('Evidence: '+config.evidence_directory)
        return 0 if outcome.status==STATUS else 1
    except Exception as exc:
        print('PARENT FAILURE: '+type(exc).__name__)
        return 1


def child_main(argv=None):
    if not ENTRY_ADMITTED:
        print('BLOCKED: production child packet/admission pending')
        return 2
    try:
        run_child(sys.argv[1:] if argv is None else argv,*load_frozen_packet(),
            {'TERRA_SMOKE_CONTEXT_SHA256':os.environ.get('TERRA_SMOKE_CONTEXT_SHA256')})
        print('CHILD OUTCOME: '+MODE)
        return 0
    except Exception as exc:
        print('CHILD FAILURE: '+type(exc).__name__)
        return 1
