# ------------------------------------------------------------------------------
# Removed Content: Paper, Datasets, Documents, JSON & Results
# ------------------------------------------------------------------------------
Paper/
data/
dataset_10k_cap/
dataset_20k_cap/
legacy_dataset_backup*/
docs/
Review/
CANONICAL_ARCHIVE/
canonical_v2_reproducibility_bundle/
issue18_bundle/
COMPRESSION_WORKSPACE/
round42_audit_tmp/
New folder/
.codex/
logs/
scratch/
scratch_*
configs/

# Ignore all markdown, json, dataset, doc and diagram files
*.md
*.json
*.jsonl
*.tsv
*.csv
*.tex
*.bib
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.mmd

# Ignore all archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Ignore backups & logs
*backup*
*_backup.*
*_backup_*.*
*.bak*
*.broken*
*.old
*.orig
*~
*.tmp
*.log
*.log.*

# ------------------------------------------------------------------------------
# Python & Environment
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
venv/
.venv/
env/
ENV/

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.token
*.secret

# Vector DBs & binary cache
chroma_db/
terra_vector_db/
*vector_db*/
frozen/
*.sqlite3
*.sqlite3-*
*.bin
*.pickle
*.pkl
baselines/cache/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.toc

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
