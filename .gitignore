# ==============================================================================
# TERRA: Peer Review & Reproducibility Repository
# .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets & Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.token
*.secret
*.p8
*.p12
*id_rsa*

# ------------------------------------------------------------------------------
# 2. Dependencies, Virtual Environments & Native Binaries
# ------------------------------------------------------------------------------
node_modules/
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.node
*.wasm
*.pyd
.pytest_cache/
.cache/
build/
dist/
*.egg-info/

# ------------------------------------------------------------------------------
# 3. Temporary, Scratch & Intermediate Workspaces
# ------------------------------------------------------------------------------
tmp/
scratch/
scratch_*
*.tmp
*.swp
*.part
.system_generated/
round42_audit_tmp/
COMPRESSION_WORKSPACE/
New folder/
.codex/

# ------------------------------------------------------------------------------
# 4. Backups & Historical Conversation Dumps with Raw Inputs
# ------------------------------------------------------------------------------
*backup*
*_backup.*
*_backup_*.*
*.bak*
*.broken*
*.old
*.orig
*~

# ------------------------------------------------------------------------------
# 5. Vector DBs, SQLite Stores & Binary Cache
# ------------------------------------------------------------------------------
chroma_db/
terra_vector_db/
*vector_db*/
frozen/
*.sqlite3
*.sqlite3-*
*.bin
*.pickle
*.pkl
baselines/cache/

# ------------------------------------------------------------------------------
# 6. Uncompressed JSON Files Exceeding GitHub Limits & Raw Pilot Dumps
# (Full dataset preserved in tracked .json.gz companion files)
# ------------------------------------------------------------------------------
dataset_20k_cap/terra_eeg_index_20k.json
dataset_20k_cap/temporal_subgraphs/eeg_subgraph_T1980.json
dataset_20k_cap/temporal_subgraphs/eeg_subgraph_T1970.json
dataset_20k_cap/temporal_subgraphs/eeg_subgraph_T1950.json
dataset_20k_cap/temporal_subgraphs/eeg_subgraph_T1930.json
data/issue26_hyperparameter_sensitivity.json
terra_*raw*.json
terra_*generations*.json
terra_expanded_*.json
terra_true_ablation_*.json
terra_baselines_eval_raw*.json
reports/**/events.jsonl

# ------------------------------------------------------------------------------
# 7. LaTeX Build Artifacts (Keep .tex, .bib, and .pdf; ignore auxiliary builds)
# ------------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.toc

# ------------------------------------------------------------------------------
# 8. Runtime Logs
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*

# ------------------------------------------------------------------------------
# 9. IDE & Operating System Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

kaggle_dataset_staging/

